# Copy to backend/.env and fill in. backend/.env is gitignored.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FAST_MODEL=openai/gpt-oss-20b
EMBED_MODEL=BAAI/bge-small-en-v1.5

# Comma-separated emails allowed to call POST /api/admin/crawl
ADMIN_EMAILS=
# Leave empty to auto-generate one in data/.jwt_secret
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000

CRAWL_INTERVAL_HOURS=168
CRAWL_MAX_PAGES=600
ENABLE_SCHEDULER=true

# Sign-up verification emails. Gmail: create an App Password (Google Account >
# Security > 2-Step Verification > App passwords) and use it as SMTP_PASSWORD.
# Leave SMTP_HOST empty to print codes in the backend log instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
